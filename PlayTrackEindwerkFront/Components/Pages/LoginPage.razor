@page "/"
@page "/login"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Inloggen - PlayTrack</PageTitle>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-logo">
            
            <h1>Welkom Terug</h1>
            
        </div>
        <div class="login-form">
            <div class="form-group">
                <label>Voornaam</label>
                <input @bind="voornaam" placeholder="bijv. Diogo" class="form-input" />
            </div>
            <div class="form-group">
                <label>Achternaam</label>
                <input @bind="achternaam" placeholder="bijv. Machado Lopes" class="form-input" />
            </div>
            @if (fout)
            {
                <div class="error-msg"> Speler niet gevonden. Controleer je naam.</div>
                <button class="register-hint-btn" @onclick="OpenRegister"> Maak hier een account aan →</button>
            }
            <button class="login-btn" @onclick="Login" disabled="@bezig">
                <span>@(bezig ? "Bezig..." : "Inloggen →")</span>
            </button>
        </div>
    </div>
</div>

@if (toonRegister)
{
    <div class="modal-overlay" @onclick="SluitRegister">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Account aanmaken</h2>
                <button class="sluit-btn" @onclick="SluitRegister">✕</button>
            </div>
            <div class="form-group">
                <label>Voornaam</label>
                <input @bind="regVoornaam" placeholder="bijv. Diogo" class="form-input" />
            </div>
            <div class="form-group">
                <label>Achternaam</label>
                <input @bind="regAchternaam" placeholder="bijv. Machado Lopes" class="form-input" />
            </div>
            <div class="form-group">
                <label>Positie</label>
                <select @bind="regPositie" class="form-input">
                    <option value="">-- Kies positie --</option>
                    <option value="GK">Doelman (GK)</option>
                    <option value="LA">LinksAchter (LA)</option>
                    <option value="RA">RechtsAchter (RA)</option>
                    <option value="CV">Centrale Verdediger (CV)</option>
                    <option value="CM">Middenvelder (CM)</option>
                    <option value="DM">Defensive Middenvelder (DM)</option>
                    <option value="LB">Linksbuiten (LB)</option>
                    <option value="RB">Rechtsbuiten (RB)</option>
                    <option value="RM">Rechtsmidden (RM)</option>
                    <option value="LM">Linksmidden (LM)</option>
                    <option value="CF">Aanvallendemiddenvelder (CF)</option>
                    <option value="ST">Spits (ST)</option>
                </select>
            </div>
            <div class="form-group">
                <label>Team</label>
                <input @bind="regTeam" placeholder="bijv. Olen United" class="form-input" />
            </div> 

            @if (!string.IsNullOrEmpty(regFout))
            {
                <div class="error-msg"> @regFout</div>
            }
            @if (regSucces)
            {
                <div class="succes-msg"> Account aangemaakt! Je wordt ingelogd...</div>
            }
            <button class="login-btn" @onclick="Registreer" disabled="@regBezig">
                <span>@(regBezig ? "Bezig..." : "Account aanmaken →")</span>
            </button>
        </div>
    </div>
}

@code {
    string voornaam = "", achternaam = "";
    bool fout = false, bezig = false;
    bool toonRegister = false;
    string regVoornaam = "", regAchternaam = "", regPositie = "", regFout = "";
    bool regBezig = false, regSucces = false;
    string regTeam = "";

    async Task Login()
    {
        if (string.IsNullOrWhiteSpace(voornaam) || string.IsNullOrWhiteSpace(achternaam)) return;
        bezig = true; fout = false;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/Login", new { Voornaam = voornaam, Achternaam = achternaam });
            bezig = false;
            if (response.IsSuccessStatusCode)
            {
                var speler = await response.Content.ReadFromJsonAsync<SpelerResult>();
                await JS.InvokeVoidAsync("localStorage.setItem", "spelerId", speler!.Id.ToString());
                await JS.InvokeVoidAsync("localStorage.setItem", "spelerNaam", speler.Voornaam + " " + speler.Achternaam); // ← toevoegen
                Nav.NavigateTo("/wedstrijd");
            }
            else fout = true;
        }
        catch
        {
            bezig = false;
            fout = true;
        }
    }

    void OpenRegister() { regVoornaam = voornaam; regAchternaam = achternaam; regFout = ""; regSucces = false; toonRegister = true; }
    void SluitRegister() { toonRegister = false; }

    async Task Registreer()
    {
        if (string.IsNullOrWhiteSpace(regVoornaam) || string.IsNullOrWhiteSpace(regAchternaam)) { regFout = "Vul voornaam en achternaam in."; return; }
        if (string.IsNullOrWhiteSpace(regPositie)) { regFout = "Kies een positie."; return; }
        
        regBezig = true; regFout = "";
        if (string.IsNullOrWhiteSpace(regTeam)) { regFout = "Vul je teamnaam in."; return; }
        var response = await Http.PostAsJsonAsync("/api/Register", new { Voornaam = regVoornaam, Naam = regAchternaam, Geboortedatum = (string?)null, Positie = regPositie, Rugnummer = 1, Team = regTeam });
        regBezig = false;
        if (response.IsSuccessStatusCode)
        {
            regSucces = true;
            await Task.Delay(1500);
            toonRegister = false; voornaam = regVoornaam; achternaam = regAchternaam;
            await Login();
        }
        else regFout = $"Fout: {await response.Content.ReadAsStringAsync()}";
    }
    record SpelerResult(int Id, string Voornaam, string Achternaam, string Positie);
}

