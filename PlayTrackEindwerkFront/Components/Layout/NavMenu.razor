@inject IJSRuntime JS
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="sidebar-wrapper">

    <!-- Ingelogde gebruiker -->
    @if (!string.IsNullOrEmpty(loggedInNaam))
    {
        <div class="sidebar-user">
            <span class="user-name">👤 @loggedInNaam</span>
            <button @onclick="Logout" class="logout-btn">Uitloggen</button>
        </div>
    }

    <!-- Logo sectie -->
    <div class="sidebar-logo">
        <div class="logo-circle">⚽</div>
        <div class="logo-text">
            <span class="logo-title">PlayTrack</span>
            <span class="logo-sub"></span>
        </div>
    </div>

    <!-- Divider -->
    <div class="sidebar-divider"></div>

    <div class="nav-label"></div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
        <nav class="flex-column">
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-icon">🏠</span>
                    <span class="nav-text">Inloggen</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Wedstrijd">
                    <span class="nav-icon">🏆</span>
                    <span class="nav-text">Wedstrijden</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="Seizoen">
                    <span class="nav-icon">📊</span>
                    <span class="nav-text">Seizoen</span>
                </NavLink>
            </div>
        </nav>
    </div>

</div>

@code {
    private string loggedInNaam = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(100);
                var naam = await JS.InvokeAsync<string?>("localStorage.getItem", "spelerNaam");
                loggedInNaam = naam ?? "";
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "spelerId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "spelerNaam");
        loggedInNaam = "";
        StateHasChanged();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}